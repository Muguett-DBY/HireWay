{
  "name": "hireway",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "postinstall": "npm run build",
    "dev": "vite",
    "build": "wrangler types && tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run build",
    "data:build": "python scripts/data/build_reference_data.py",
    "data:build:iteration1": "python scripts/data/build_iteration_one_data.py",
    "data:build:market": "python scripts/data/build_market_data.py",
    "data:build:discovery": "python scripts/data/build_discovery_data.py",
    "data:apply:local": "wrangler d1 execute hireway-db --local --file data/generated/reference_data.sql",
    "data:apply:iteration1:local": "wrangler d1 execute hireway-db --local --file data/generated/iteration_one_reference_data.sql",
    "data:apply:market:local": "wrangler d1 execute hireway-db --local --file data/generated/market_data.sql",
    "data:apply:discovery:local": "wrangler d1 execute hireway-db --local --file data/generated/discovery_data.sql",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "lucide": "^1.40.0",
    "morphicons": "^1.7.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "wrangler": "^4.127.1"
  }
}
