def clean_onet_code(v):
    v = clean(v)
    return str(v).strip() if v is not None else None


def pivot_onet_rating_file(path, out_name, requirement_type):
    """Pivot O*NET IM/LV rows to one row per occupation + element."""
    grouped = {}
    for rec in csv_rows(path):
        if yn(rec.get('Recommend Suppress')) == 'Y':
            continue
        soc = clean_onet_code(rec.get('O*NET-SOC Code'))
        element = clean(rec.get('Element ID'))
        if not soc or not element:
            continue
        key = (soc, element)
        g = grouped.setdefault(key, {
            'onet_soc_code': soc,
            'title': clean(rec.get('Title')),
            'element_id': element,
            'element_name': clean(rec.get('Element Name')),
            'importance': None,
            'level': None,
            'importance_n': None,
            'level_n': None,
            'not_relevant': None,
            'date': clean(rec.get('Date')),
            'domain_source': clean(rec.get('Domain Source')),
        })
        sid = clean(rec.get('Scale ID'))
        if sid == 'IM':
            g['importance'] = num(rec.get('Data Value'))
            g['importance_n'] = int_or_none(rec.get('N'))
        elif sid == 'LV':
            g['level'] = num(rec.get('Data Value'))
            g['level_n'] = int_or_none(rec.get('N'))
            g['not_relevant'] = yn(rec.get('Not Relevant'))

    cols = [
        'onet_soc_code','title','requirement_type','element_id','element_name',
        'importance','level','importance_n','level_n','not_relevant',
        'date','domain_source','data_source'
    ]
    rows = []
    for g in grouped.values():
        rows.append([
            g['onet_soc_code'], g['title'], requirement_type, g['element_id'], g['element_name'],
            g['importance'], g['level'], g['importance_n'], g['level_n'], g['not_relevant'],
            g['date'], g['domain_source'], 'O*NET'
        ])
    rows.sort(key=lambda r: (r[0], -(r[5] if isinstance(r[5], (int, float)) else -1), r[4] or ''))
    write_csv(out_name, cols, rows)
    return rows


