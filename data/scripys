from pathlib import Path
import csv, re, datetime as dt, zipfile
import xml.etree.ElementTree as ET
from collections import defaultdict

BASE = Path(__file__).resolve().parent
OUT = BASE / 'hireway_final_cleaned'
OUT.mkdir(exist_ok=True)

NS = {
    'main': 'http://schemas.openxmlformats.org/spreadsheetml/2006/main',
    'r': 'http://schemas.openxmlformats.org/officeDocument/2006/relationships',
}
MISSING = {'', 'n/a', 'na', 'null', 'none', '-', '—', '–', '..', '...'}


def pick(pattern):
    files = sorted(BASE.glob(pattern))
    if not files:
        raise FileNotFoundError(
            f'Cannot find input matching: {pattern}\n'
            f'Please put the required Excel file in the same folder as this script:\n{BASE}'
        )
    chosen = files[-1]
    print(f'[FOUND] {chosen.name}')
    return chosen


def pick_csv(filename, required=True):
    matches = sorted(BASE.glob(filename))
    if not matches:
        if required:
            raise FileNotFoundError(
                f'Cannot find CSV input: {filename}\n'
                f'Please put the O*NET CSV files in the same folder as this script:\n{BASE}'
            )
        print(f'[SKIP] optional CSV not found: {filename}')
        return None
    chosen = matches[-1]
    print(f'[FOUND] {chosen.name}')
    return chosen


def csv_rows(path):
    with Path(path).open(encoding='utf-8-sig', newline='') as f:
        for rec in csv.DictReader(f):
            yield {k: clean(v) for k, v in rec.items()}


def num(v):
    v = clean(v)
    if v is None:
        return None
    try:
        return float(v)
    except (TypeError, ValueError):
        return None


def int_or_none(v):
    x = num(v)
    return int(x) if x is not None and float(x).is_integer() else x


def yn(v):
    v = clean(v)
    return str(v).upper() if v is not None else None


def col_idx(ref):
    m = re.match(r'([A-Z]+)', ref or 'A')
    n = 0
    for ch in m.group(1):
        n = n * 26 + ord(ch) - 64
    return n - 1


def workbook_info(path):
    with zipfile.ZipFile(path) as z:
        wb = ET.fromstring(z.read('xl/workbook.xml'))
        rels = ET.fromstring(z.read('xl/_rels/workbook.xml.rels'))
        rmap = {rel.attrib['Id']: rel.attrib['Target'] for rel in rels}
        out = {}
        for sh in wb.find('main:sheets', NS):
            name = sh.attrib['name']
            rid = sh.attrib['{http://schemas.openxmlformats.org/officeDocument/2006/relationships}id']
            target = rmap[rid]
            if not target.startswith('/'):
                target = 'xl/' + target if not target.startswith('xl/') else target
            else:
                target = target.lstrip('/')
            out[name] = target.replace('xl/../', '')
        return out


def shared_strings(z):
    if 'xl/sharedStrings.xml' not in z.namelist():
        return []
    root = ET.fromstring(z.read('xl/sharedStrings.xml'))
    vals = []
    for si in root.findall('main:si', NS):
        vals.append(''.join((x.text or '') for x in si.findall('.//main:t', NS)))
    return vals


def date_styles(z):
    if 'xl/styles.xml' not in z.namelist():
        return set()
    root = ET.fromstring(z.read('xl/styles.xml'))
    custom = {}
    numfmts = root.find('main:numFmts', NS)
    if numfmts is not None:
        for f in numfmts:
            custom[int(f.attrib['numFmtId'])] = f.attrib.get('formatCode', '')
    builtin = {14,15,16,17,18,19,20,21,22,27,30,36,45,46,47,50,57}
    result = set()
    xfs = root.find('main:cellXfs', NS)
    if xfs is not None:
        for i, xf in enumerate(xfs):
            fmtid = int(xf.attrib.get('numFmtId', '0'))
            fmt = re.sub(r'".*?"|\[.*?\]|\\.', '', custom.get(fmtid, '').lower())
            if fmtid in builtin or (('y' in fmt or 'd' in fmt) and 'm' in fmt):
                result.add(i)
    return result


def excel_date(raw):
    return dt.datetime(1899, 12, 30) + dt.timedelta(days=float(raw))
