def top_requirement_names(rows, n=6):
    by = defaultdict(list)
    for r in rows:
        score = r[5] if isinstance(r[5], (int, float)) else -1
        by[r[0]].append((score, r[4]))
    return {
        k: '; '.join(name for _, name in sorted(v, key=lambda x: (-x[0], x[1] or ''))[:n] if name)
        for k, v in by.items()
    }

