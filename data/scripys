def abs_counts(sheet,out_name,label_name):
    start=False; out=[]
    for r in iter_sheet_rows(ABS_INCOME,sheet):
        rr=[clean(x) for x in r]+[None]*4
        if not start:
            if rr[1]=='Males' and rr[2]=='Females' and rr[3]=='Persons': start=True
            continue
        if clean(rr[0]) and any(isinstance(x,(int,float)) for x in rr[1:4]): out.append(rr[:4])
    write_csv(out_name,[label_name,'males','females','persons'],out)
