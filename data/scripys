def pick(pattern):
    files = sorted(BASE.glob(pattern))
    if not files:
        raise FileNotFoundError(
            f'Cannot find input matching: {pattern}\n'
            f'Please put the required Excel file in the same folder as this script:\n{BASE}'
        )
    chosen = files[-1]
    print(f'[FOUND] {chosen.name}')
    return chosen


def pick_csv(filename, required=True):
    matches = sorted(BASE.glob(filename))
    if not matches:
        if required:
            raise FileNotFoundError(
                f'Cannot find CSV input: {filename}\n'
                f'Please put the required CSV file in the same folder as this script:\n{BASE}'
            )
        print(f'[SKIP] optional CSV not found: {filename}')
        return None
    chosen = matches[-1]
    print(f'[FOUND] {chosen.name}')
    return chosen


def csv_rows(path):
    with Path(path).open(encoding='utf-8-sig', newline='') as f:
        for rec in csv.DictReader(f):
            yield {k: clean(v) for k, v in rec.items()}


def num(v):
    v = clean(v)
    if v is None:
        return None
    try:
        return float(v)
    except (TypeError, ValueError):
        return None


def int_or_none(v):
    x = num(v)
    return int(x) if x is not None and float(x).is_integer() else x


def yn(v):
    v = clean(v)
    return str(v).upper() if v is not None else None


def col_idx(ref):
    m = re.match(r'([A-Z]+)', ref or 'A')
    n = 0
    for ch in m.group(1):
        n = n * 26 + ord(ch) - 64
    return n - 1


def workbook_info(path):
    with zipfile.ZipFile(path) as z:
        wb = ET.fromstring(z.read('xl/workbook.xml'))
        rels = ET.fromstring(z.read('xl/_rels/workbook.xml.rels'))
        rmap = {rel.attrib['Id']: rel.attrib['Target'] for rel in rels}
        out = {}
        for sh in wb.find('main:sheets', NS):
            name = sh.attrib['name']
            rid = sh.attrib['{http://schemas.openxmlformats.org/officeDocument/2006/relationships}id']
            target = rmap[rid]
            if not target.startswith('/'):
                target = 'xl/' + target if not target.startswith('xl/') else target
            else:
                target = target.lstrip('/')
            out[name] = target.replace('xl/../', '')
        return out


def shared_strings(z):
    if 'xl/sharedStrings.xml' not in z.namelist():
        return []
    root = ET.fromstring(z.read('xl/sharedStrings.xml'))
    vals = []
    for si in root.findall('main:si', NS):
        vals.append(''.join((x.text or '') for x in si.findall('.//main:t', NS)))
    return vals


def date_styles(z):
    if 'xl/styles.xml' not in z.namelist():
        return set()
    root = ET.fromstring(z.read('xl/styles.xml'))
    custom = {}
    numfmts = root.find('main:numFmts', NS)
    if numfmts is not None:
        for f in numfmts:
            custom[int(f.attrib['numFmtId'])] = f.attrib.get('formatCode', '')
    builtin = {14,15,16,17,18,19,20,21,22,27,30,36,45,46,47,50,57}
    result = set()
    xfs = root.find('main:cellXfs', NS)
    if xfs is not None:
        for i, xf in enumerate(xfs):
            fmtid = int(xf.attrib.get('numFmtId', '0'))
            fmt = re.sub(r'".*?"|\[.*?\]|\\.', '', custom.get(fmtid, '').lower())
            if fmtid in builtin or (('y' in fmt or 'd' in fmt) and 'm' in fmt):
                result.add(i)
    return result


def excel_date(raw):
    return dt.datetime(1899, 12, 30) + dt.timedelta(days=float(raw))


def iter_sheet_rows(path, sheet_name):
    with zipfile.ZipFile(path) as z:
        target = workbook_info(path)[sheet_name]
        ss = shared_strings(z)
        dstyles = date_styles(z)
        with z.open(target) as fh:
            for _, elem in ET.iterparse(fh, events=('end',)):
                if not elem.tag.endswith('}row'):
                    continue
                rowdict = {}
                for c in elem:
                    if not c.tag.endswith('}c'):
                        continue
                    idx = col_idx(c.attrib.get('r'))
                    typ = c.attrib.get('t')
                    style = int(c.attrib.get('s', '0'))
                    v = c.find('main:v', NS)
                    if typ == 'inlineStr':
                        val = ''.join((x.text or '') for x in c.findall('.//main:t', NS))
                    elif v is None:
                        val = None
                    else:
                        raw = v.text
                        if typ == 's':
                            val = ss[int(raw)]
                        elif typ == 'b':
                            val = bool(int(raw))
                        elif typ in ('str', 'e'):
                            val = raw
                        elif style in dstyles:
                            val = excel_date(raw)
                        else:
                            try:
                                x = float(raw)
                                val = int(x) if x.is_integer() else x
                            except Exception:
                                val = raw
                    rowdict[idx] = val
                if rowdict:
                    row = [None] * (max(rowdict) + 1)
                    for i, v in rowdict.items():
                        row[i] = v
                    yield row
                else:
                    yield []
                elem.clear()


def clean(v):
    if v is None:
        return None
    if isinstance(v, str):
        s = re.sub(r'\s+', ' ', v.strip())
        return None if s.lower() in MISSING else s
    return v


def code(v):
    v = clean(v)
    if v is None:
        return None
    if isinstance(v, float) and v.is_integer():
        v = int(v)
    s = str(v).strip()
    if s.endswith('.0'):
        s = s[:-2]
    return None if s in ('', '.') else s


def fixed_code(v, width):
    """Return a classification code as text with preserved leading zeros."""
    s = code(v)
    if s is None:
        return None
    return s.zfill(width) if s.isdigit() else s


def split_code_label(v):
    """Split values such as '0201 - Computer Science' into code and label."""
    s = clean(v)
    if s is None:
        return None, None
    m = re.match(r'^\s*([0-9]+)\s*-\s*(.+?)\s*$', str(s))
    if m:
        return m.group(1), clean(m.group(2))
    return None, s


def money_aud(v):
    """Convert CRICOS currency strings such as '$13,300.00' to numeric AUD values."""
    s = clean(v)
    if s is None:
        return None
    s = re.sub(r'[^0-9.\-]', '', str(s))
    try:
        x = float(s)
        return int(x) if x.is_integer() else x
    except (TypeError, ValueError):
        return None


def snake(s):
    if s is None:
        return ''
    s = re.sub(r'[¹²³⁴⁵⁶⁷⁸⁹⁰]', '', str(s).strip())
    s = s.replace('%', ' pct ').replace('$', ' aud ').replace('&', ' and ')
    s = re.sub(r'[\n\r]+', ' ', s)
    s = re.sub(r'[()/\-]+', ' ', s)
    s = re.sub(r'[^A-Za-z0-9]+', '_', s)
    return re.sub(r'_+', '_', s).strip('_').lower()


def parse_month(v):
    if isinstance(v, dt.datetime):
        return v.date().isoformat()
    if isinstance(v, dt.date):
        return v.isoformat()
    if isinstance(v, str):
        for fmt in ('%b-%y', '%b %y', '%Y-%m-%d'):
            try:
                return dt.datetime.strptime(v.strip(), fmt).date().isoformat()
            except ValueError:
                pass
    return None


def read_table(path, sheet, required_headers):
    wanted = [required_headers] if isinstance(required_headers, str) else list(required_headers)
    found = False
    header = None
    data = []
    for r in iter_sheet_rows(path, sheet):
        vals = [clean(x) for x in r]
        if not found and all(any(str(x).strip().lower() == w.lower() for x in vals if x is not None) for w in wanted):
            header = [snake(x) for x in vals]
            found = True
            continue
        if found and any(x is not None for x in vals):
            vals += [None] * (len(header) - len(vals))
            data.append(vals[:len(header)])
    if not found:
        raise ValueError(f'Header not found: {path.name} / {sheet}')
    last = max(i for i, h in enumerate(header) if h)
    return header[:last+1], [r[:last+1] for r in data]


def write_csv(name, header, rows):
    p = OUT / name
    with p.open('w', newline='', encoding='utf-8-sig') as f:
        w = csv.writer(f)
        w.writerow(header)
        for r in rows:
            w.writerow([clean(x) for x in r])
    return p


def stream_wide(path, sheet, header_pred, id_names, id_count, out_name, value_name, row_filter=None):
    p = OUT / out_name
    count = 0
    with p.open('w', newline='', encoding='utf-8-sig') as f:
        w = csv.writer(f)
        w.writerow(id_names + ['date', value_name])
        header = None
        for r in iter_sheet_rows(path, sheet):
            rr = [clean(x) for x in r]
            if header is None:
                if header_pred(rr):
                    header = rr
                continue
            if not any(x is not None for x in rr):
                continue
            rr += [None] * (len(header) - len(rr))
            if row_filter and not row_filter(rr, header):
                continue
            ids = rr[:id_count]
            for j in range(id_count, len(header)):
                date = parse_month(header[j])
                if not date:
                    continue
                val = clean(rr[j])
                if val is not None:
                    w.writerow(ids + [date, val])
                    count += 1
    return count


def latest_wide(path, sheet, header_pred, id_names, id_count, out_name, value_name, row_filter=None):
    header = None
    out = []
    for r in iter_sheet_rows(path, sheet):
        rr = [clean(x) for x in r]
        if header is None:
            if header_pred(rr):
                header = rr
            continue
        if not any(x is not None for x in rr):
            continue
        rr += [None] * (len(header) - len(rr))
        if row_filter and not row_filter(rr, header):
            continue
        date_cols = [j for j in range(id_count, len(header)) if parse_month(header[j])]
        if not date_cols:
            continue
        j = date_cols[-1]
        val = clean(rr[j])
        if val is not None:
            out.append(rr[:id_count] + [parse_month(header[j]), val])
    write_csv(out_name, id_names + ['date', value_name], out)
    return out


def filtered_table(path, sheet, required_headers, predicate, out_name):
    h, d = read_table(path, sheet, required_headers)
    out = []
    for r in d:
        rec = {h[i]: clean(r[i]) for i in range(len(h))}
        if predicate(rec):
            out.append([rec.get(c) for c in h])
    write_csv(out_name, h, out)
    return h, out


